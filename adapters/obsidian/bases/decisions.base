# 意思決定記録（ADR）の一覧。proposed のまま 30 日を超えたものは freshness.base にも出る
filters:
  and:
    - file.inFolder("decisions")
    - 'type == "decision"'
views:
  - type: table
    name: 意思決定記録
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - id
      - status
      - business
      - created
      - updated
