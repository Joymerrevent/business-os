{
  "name": "business-os",
  "version": "0.4.0",
  "private": true,
  "description": "A Claude Code plugin for people who run several businesses alone (alpha).",
  "homepage": "https://github.com/Joymerrevent/business-os#readme",
  "bugs": {
    "url": "https://github.com/Joymerrevent/business-os/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joymerrevent/business-os.git"
  },
  "license": "MIT",
  "author": "Joymerrevent (https://joymerrevent.com/)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "check": "pnpm run \"/^check:[^:]+$/\"",
    "check:md": "markdownlint-cli2",
    "check:format": "prettier --check .",
    "check:lint": "eslint .",
    "check:types": "tsc --noEmit",
    "check:test": "vitest run",
    "check:skills": "node plugin/scripts/check-repo.ts skills",
    "check:agents": "node plugin/scripts/check-repo.ts agents",
    "check:hooks": "node plugin/scripts/check-repo.ts hooks",
    "check:plugin": "node plugin/scripts/check-repo.ts plugin",
    "check:templates": "node plugin/scripts/check-repo.ts templates",
    "check:leak": "node plugin/scripts/check-repo.ts leak",
    "check:docs": "node plugin/scripts/check-repo.ts docs",
    "check:adr": "node plugin/scripts/check-repo.ts adr",
    "check:usage": "node plugin/scripts/check-repo.ts usage",
    "check:adapters": "node plugin/scripts/check-repo.ts adapters",
    "check:release": "node plugin/scripts/check-repo.ts release",
    "check:shell": "node plugin/scripts/check-repo.ts shell",
    "check:evals": "node plugin/scripts/check-repo.ts evals",
    "check:forms": "node plugin/scripts/check-repo.ts forms",
    "format": "prettier --write .",
    "fix:md": "markdownlint-cli2 --fix",
    "changeset": "changeset",
    "prepare": "simple-git-hooks",
    "test": "vitest run",
    "eval:cases": "node evals/lib/cases/run.ts",
    "eval:dialogue": "node evals/lib/dialogue/run.ts",
    "release:version": "changeset version && node plugin/scripts/sync-plugin-version.ts && prettier --write plugin/.claude-plugin/plugin.json"
  },
  "simple-git-hooks": {
    "pre-commit": "node plugin/scripts/pre-commit.ts",
    "commit-msg": "pnpm exec commitlint --edit \"$1\""
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "ajv": "^8.20.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  }
}
